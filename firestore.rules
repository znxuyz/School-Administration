rules_version = '2';

// 行政工作進度追蹤系統 — Firestore 安全規則
//
// 核心原則:
//   1. 沒登入 → 什麼都不能做。
//   2. 登入了但 Email 不在 allowlist 名單 → 什麼都不能做。
//   3. 看得到的範圍分層:組長只有自己的、主任加上同處室、管理員全部。
//   4. 不管看得到多少,能改的只有自己的計畫(管理員例外)。
//   5. 只有 role == 'admin' 的成員可以管理名單。
//
// 貼上位置:Firebase 主控台 → Firestore Database → 規則 → 全部貼上 → 發布

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null && request.auth.token.email != null;
    }

    // 以小寫 Email 當作名單的文件 ID
    function emailKey() {
      return request.auth.token.email.lower();
    }

    function memberPath() {
      return /databases/$(database)/documents/allowlist/$(emailKey());
    }

    // 是名單內的成員(且 Google 已驗證該 Email)
    function isMember() {
      return signedIn()
        && request.auth.token.email_verified == true
        && exists(memberPath());
    }

    function memberData() {
      return get(memberPath()).data;
    }

    function isAdmin() {
      return isMember() && memberData().role == 'admin';
    }

    // 主任看得到同處室的計畫(唯讀,不能代為修改)
    function isDirectorOf(dept) {
      return isMember() && memberData().role == 'director' && memberData().dept == dept;
    }

    // ---------- 成員名單 ----------
    match /allowlist/{email} {
      // 自己的那筆一定要讀得到(登入時要判斷角色);整份名單只有管理員需要
      allow read: if isMember() && (isAdmin() || email == emailKey());

      // 只有管理者能異動名單
      allow create, update: if isAdmin()
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.dept is string
        // teacher 是舊資料的角色名稱,程式會視為組長
        && request.resource.data.role in ['staff', 'director', 'admin', 'teacher'];

      allow delete: if isAdmin();
    }

    // ---------- 行政計畫 ----------
    match /plans/{planId} {

      // 選填欄位一律寫成「沒有這個欄位 || 內容正確」。
      // 規則語言的 || 會短路,舊資料沒有該欄位時就不會去讀它(讀不存在的鍵會整條失敗),
      // 所以這裡不能為了少打幾個字而把條件包成函式 —— 參數會被先算出來。
      //
      // 另外:規則語言沒有迴圈,無法逐一檢查 steps / flow 裡每個元素的內容,
      // 只能限制筆數。每個步驟的欄位由前端存檔前整理(見 app.js 表單送出的地方)。
      function validPlan(d) {
        return d.title is string && d.title.size() > 0 && d.title.size() <= 200
          && d.dept is string && d.dept.size() <= 20
          // 民國學年度的合理範圍,擋掉誤填西元年之類的數字
          && d.year is int && d.year >= 90 && d.year <= 200
          && d.steps is list && d.steps.size() <= 100
          && (!d.keys().hasAny(['term']) || d.term in ['0', '1', '2'])
          && (!d.keys().hasAny(['note']) || (d.note is string && d.note.size() <= 2000))
          && (!d.keys().hasAny(['startDate']) || (d.startDate is string && d.startDate.size() <= 10))
          && (!d.keys().hasAny(['endDate']) || (d.endDate is string && d.endDate.size() <= 10))
          // 公文流轉紀錄與所在單位為選填(舊資料沒有這些欄位也不會被擋)
          && (!d.keys().hasAny(['flow']) || (d.flow is list && d.flow.size() <= 300))
          && (!d.keys().hasAny(['handovers']) || (d.handovers is list && d.handovers.size() <= 50))
          && (!d.keys().hasAny(['location']) || d.location is string)
          && (!d.keys().hasAny(['budget']) || (d.budget is number && d.budget >= 0))
          && (!d.keys().hasAny(['recurring']) || d.recurring in ['', 'half', 'year'])
          && (!d.keys().hasAny(['ownerName']) || (d.ownerName is string && d.ownerName.size() <= 50))
          && (!d.keys().hasAny(['updatedByName'])
              || (d.updatedByName is string && d.updatedByName.size() <= 50))
          // 刪除是可還原的:deletedAt 有值代表在垃圾桶裡
          && (!d.keys().hasAny(['deletedAt']) || d.deletedAt is string)
          && (!d.keys().hasAny(['deletedBy']) || (d.deletedBy is string && d.deletedBy.size() <= 50))
          // 掃描檔連結只收 http/https,前端也會再擋一次
          && (!d.keys().hasAny(['driveUrl'])
              || (d.driveUrl is string && d.driveUrl.size() <= 500
                  && (d.driveUrl == '' || d.driveUrl.matches('https?://.*'))));
      }

      // 可見範圍分層:組長只看自己的、主任看同處室、管理員看全部。
      // 承辦人一律以 ownerEmail 判定(職務交接後 uid 會換人,Email 才是穩定的依據)。
      // 前端的查詢條件必須和這裡一致,否則 Firestore 會拒絕整個查詢。
      allow read: if isMember()
        && (isAdmin()
            || resource.data.ownerEmail == emailKey()
            || isDirectorOf(resource.data.dept));

      // 只能以自己的身分建立計畫
      allow create: if isMember()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerEmail == emailKey()
        && validPlan(request.resource.data);

      // 只有承辦人自己和管理員能改。主任看得到但不能代為修改。
      //
      // 承辦人欄位平常不可異動;唯一的例外是職務交接 ——
      // 管理員可以把承辦人換成名單內的另一位成員。
      allow update: if isMember()
        && (resource.data.ownerEmail == emailKey() || isAdmin())
        && (
             request.resource.data.ownerEmail == resource.data.ownerEmail
             || (isAdmin()
                 && request.resource.data.ownerEmail is string
                 && exists(/databases/$(database)/documents/allowlist/$(request.resource.data.ownerEmail)))
           )
        && validPlan(request.resource.data);

      allow delete: if isMember()
        && (resource.data.ownerEmail == emailKey() || isAdmin());
    }

    // 其他路徑一律禁止
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
